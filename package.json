{
  "name": "minicode-ai",
  "version": "0.12.0",
  "description": "Coding agent CLI built on the frozen MiniCore runtime — tools, MCP, LSP, sandbox, shadow-git checkpoints",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "coding-assistant",
    "terminal",
    "llm",
    "llm-agent",
    "mcp",
    "lsp",
    "bun",
    "openai",
    "anthropic",
    "ollama"
  ],
  "homepage": "https://minicode.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startupmini/minicode.git"
  },
  "bugs": {
    "url": "https://github.com/startupmini/minicode/issues"
  },
  "bin": {
    "minicode": "./cli/index.ts"
  },
  "imports": {
    "#minicore": "./vendor/minicore/src/core/index.ts",
    "#minicore/*": "./vendor/minicore/src/*"
  },
  "engines": {
    "bun": ">=1.1.13"
  },
  "files": [
    "cli",
    "src",
    "vendor/minicore/src",
    "vendor/minicore/package.json",
    "vendor/minicore/VENDOR.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/OUTPUT_ARCHITECTURE_AUDIT.md",
    "docs/OUTPUT_EVENT_MODEL.md",
    "docs/OUTPUT_IMPLEMENTATION_PLAN.md",
    "docs/OUTPUT_PROTOCOL_SPEC.md",
    "docs/OUTPUT_RENDERING_SPEC.md",
    "docs/OUTPUT_UX_RULES.md",
    "docs/PLAN_UIUX_V6.md",
    "docs/TERMINAL_CONTRACT.md",
    "docs/agents.md",
    "docs/architecture.md",
    "docs/choosing-mode.md",
    "docs/cli.md",
    "docs/concepts.md",
    "docs/config-providers.md",
    "docs/config.md",
    "docs/contributing.md",
    "docs/environment.md",
    "docs/exec.md",
    "docs/getting-started.md",
    "docs/glossary.md",
    "docs/mcp-lsp.md",
    "docs/memory-sessions.md",
    "docs/policy-sandbox.md",
    "docs/pricing-budget.md",
    "docs/quickstart.md",
    "docs/repl.md",
    "docs/security-model.md",
    "docs/security.md",
    "docs/skills.md",
    "docs/terminal.md",
    "docs/tools.md",
    "docs/troubleshooting.md",
    "docs/verify-benchmark.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:live": "bun scripts/test-live.ts",
    "test:qa": "bun scripts/live-qa.ts",
    "test:coverage": "bun test --coverage",
    "gate:fast": "bun x tsc --noEmit && bun run lint && bun test && bun run gate:coverage && bun run gate:pack && bun run gate:bash && bun run bench:smoke && bun run audit:harness",
    "gate:slow": "bun experiments/extreme-bash-fuzz.ts --rounds 12 && bun experiments/extreme-shadow-git.ts && bun experiments/extreme-mcp-adversarial.ts",
    "gate:coverage": "bun scripts/coverage-gate.ts",
    "gate:bash": "bun experiments/bash-bypass-probe.ts && bun experiments/bash-bypass-probe.ts --mode allowlist",
    "gate:pack": "bun scripts/pack-check.ts",
    "extreme": "bun experiments/extreme-bash-fuzz.ts && bun experiments/extreme-shadow-git.ts && bun experiments/extreme-mcp-adversarial.ts",
    "extreme:fuzz": "bun experiments/extreme-bash-fuzz.ts --rounds 12",
    "extreme:git": "bun experiments/extreme-shadow-git.ts",
    "extreme:mcp": "bun experiments/extreme-mcp-adversarial.ts",
    "vendor:minicore": "bun scripts/vendor-minicore.ts",
    "vendor:check": "bun scripts/vendor-minicore.ts --check",
    "typecheck": "bun x tsc --noEmit",
    "lint": "biome check src cli test bench scripts",
    "lint:fix": "biome check --write src cli test bench scripts",
    "format": "biome format --write src cli test bench scripts",
    "gate:telemetry": "bun scripts/telemetry-gate.ts",
    "dev": "bun cli/index.ts",
    "bench": "bun bench/runner.ts",
    "bench:smoke": "bun bench/runner.ts --fake",
    "gate:eval": "bun bench/eval-gate.ts",
    "audit:harness": "bun bench/harness-audit.ts",
    "bench:runs": "bun bench/runner.ts --runs 2",
    "web:css": "bun scripts/build-web-css.ts",
    "web:build": "bun scripts/build-web-css.ts && bun scripts/build-web.ts",
    "web:serve": "bun --hot scripts/web-serve.ts",
    "web:check": "bun scripts/web-check.ts",
    "web:indexnow": "bun scripts/web-indexnow.ts",
    "web:vitals": "bun scripts/web-vitals.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
